# Cloud Code — local environment (copy to .env)
# Never commit .env. This file documents supported variables only.

# -----------------------------------------------------------------------------
# Provider selection (optional overrides)
# -----------------------------------------------------------------------------
# CLOUD_CODE_PROVIDER=anthropic
# CLOUD_CODE_MODEL=sonnet
# CLOUD_CODE_BASE_URL=
# CLOUD_CODE_API_KEY=

# -----------------------------------------------------------------------------
# API keys — set the provider(s) you use
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1

GOOGLE_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1

XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# Ollama (local; API key often optional)
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# -----------------------------------------------------------------------------
# Runtime paths & behavior
# -----------------------------------------------------------------------------
# CLAW_CONFIG_HOME=~/.config/cloud-code
# CLAW_PERMISSION_MODE=workspace
# CLAW_WEB_SEARCH_BASE_URL=
# CLAW_TODO_STORE=
# CLAW_AGENT_STORE=

# HTTP server (optional)
# CLOUD_CODE_PORT=8787
# CLOUD_CODE_WORKSPACE_ROOT=

# Integration tests / dev only
# CLAW_MODEL=claude-sonnet-4-6
# CODEX_HOME=
